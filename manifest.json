{
  "manifest_version": 3,
  "name": "Restore X Dim Mode",
  "description": "Applies a softer dark-blue dim theme on X/Twitter.",
  "version": "1.1.0",
  "permissions": ["storage"],
  "action": {
    "default_title": "Restore X Dim Mode",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["dim.css"],
      "run_at": "document_start"
    }
  ]
}
